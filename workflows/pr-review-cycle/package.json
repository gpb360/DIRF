{
  "name": "pr-review-cycle",
  "version": "1.0.0",
  "description": "Universal PR review system with AI agents and confidence scoring",
  "main": "pr-review-cli.js",
  "bin": {
    "pr-review": "./pr-review-cli.js"
  },
  "scripts": {
    "review": "node pr-review-cli.js --local",
    "review:pr": "node pr-review-cli.js --pr-url",
    "review:list": "node pr-review-cli.js --list",
    "test": "node --test fixed-point-gate.test.js",
    "setup": "bash setup.sh"
  },
  "keywords": [
    "pr-review",
    "code-review",
    "ai-agent",
    "confidence-scoring",
    "automated-review",
    "security-scan",
    "code-quality"
  ],
